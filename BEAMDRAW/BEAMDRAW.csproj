<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- C# 12: используем последнюю версию языка, как в PoseEdit2026 -->
    <LangVersion>latest</LangVersion>
    <AssemblyName>BEAMDRAW</AssemblyName>
    <RootNamespace>BEAMDRAW</RootNamespace>
  </PropertyGroup>

  <!-- AutoCAD 2024: .NET Framework 4.8 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="24.3.0" />
    <PackageReference Include="AutoCAD.NET.Core" Version="24.3.0" />
    <PackageReference Include="AutoCAD.NET.Model" Version="24.3.0" />
  </ItemGroup>

  <!-- AutoCAD 2025 + 2026: .NET 8 (25.1.0 совместим по API с 2026 в рантайме) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" />
    <PackageReference Include="AutoCAD.NET.Core" Version="25.1.0" />
    <PackageReference Include="AutoCAD.NET.Model" Version="25.1.0" />
  </ItemGroup>

</Project>
