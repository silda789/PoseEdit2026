<!-- 
    Window - это корневой элемент. Аналог 'dialog' в DCL.
    x:Class="PoseEdit2026.PoseEditWindow" - связывает эту разметку с C# кодом (файл .xaml.cs).
    Title - заголовок окна.
    ResizeMode="CanResizeWithGrip" - разрешает менять размер окна (потянув за уголок).
-->
<Window x:Class="PoseEdit2026.PoseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="POSE EDIT 2026 ARS Co." 
        Height="430" Width="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <!-- 
         Window.Resources: Это как CSS в веб-сайтах.
         Здесь мы задаем "Стили" (Styles).
         Вместо того, чтобы писать Margin="5" для каждой из 50 кнопок,
         мы пишем это один раз здесь. Это делает код чистым.
    -->
    <Window.Resources>
        <!-- Стиль для всех GroupBox (Рамок с заголовками) -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <!-- Отступ снаружи -->
            <Setter Property="Padding" Value="5"/>
            <!-- Отступ внутри -->
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <!-- Цвет рамки (светло-серый) -->
            <Setter Property="Background" Value="White"/>
            <!-- Белый фон внутри групп -->
        </Style>

        <!-- Стиль для всех Label (Надписей) -->
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Центрировать по вертикали -->
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <!-- Прижать вправо (к полю ввода) -->
            <Setter Property="Margin" Value="0,0,5,0"/>
            <!-- Отступ справа 5px -->
        </Style>

        <!-- Стиль для всех TextBox (Полей ввода) -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="22"/>
            <!-- Фиксированная высота -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Текст по центру -->
            <Setter Property="Margin" Value="0,2"/>
            <!-- Отступ сверху и снизу 2px -->
        </Style>

        <!-- Стиль для всех Button (Кнопок) -->
        <!-- ВНИМАНИЕ: Высота кнопок изменена пользователем с 26 на 22 - НЕ МЕНЯТЬ! -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#DDDDDD"/>
            <!-- Светло-серый фон кнопок -->
        </Style>
    </Window.Resources>

    <!-- 
         ГЛАВНАЯ СЕТКА (Grid).
         Grid - это самый мощный инструмент разметки. Это невидимая таблица.
         Мы делим окно на Строки (Row) и Столбцы (Column).
    -->
    <!-- 
        УДАЛЕНА ВКЛАДКА SETTINGS - теперь настройки открываются в отдельном окне
        при нажатии кнопки "Settings" в нижнем ряду кнопок
    -->
    <Grid>
        <!-- ВКЛАДКА: ОСНОВНАЯ РАБОТА (теперь единственная) -->
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Строка 0: Основная часть с блоками и кнопками. '*' значит "занять всё свободное место" -->
                </Grid.RowDefinitions>

                <!-- ВНУТРЕННЯЯ СЕТКА ДЛЯ ВЕРХНЕЙ ЧАСТИ (3 Колонки + строка для кнопок) -->
                <!-- Grid.Row="0" означает "помести эту сетку в первую строку главной сетки" -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- Строка 0: Основные блоки (Main Data, Rebar Shape Data, Preview) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Строка 1: Кнопки на уровне блоков -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <!-- Колонка 0: Левая (фиксированная ширина 260px) -->
                            <ColumnDefinition Width="280"/>
                            <!-- Колонка 1: Средняя (фиксированная 280px) -->
                            <ColumnDefinition Width="*"/>
                            <!-- Колонка 2: Правая (растягивается на остаток экрана) -->
                        </Grid.ColumnDefinitions>

                        <!-- ============================================= -->
                        <!-- 1. ЛЕВАЯ КОЛОНКА: Main Data -->
                        <!-- ============================================= -->
                        <GroupBox Header="Main Data" Grid.Column="0">
                            <!-- Внутри GroupBox создаем свою локальную сетку -->
                            <Grid>
                        <!-- Определяем столбцы: Подпись | Поле | Кнопка Link -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <!-- Для надписей (Pose:) -->
                            <ColumnDefinition Width="*"/>
                            <!-- Для полей ввода (растягивается) -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Для кнопки Link (ширина по содержимому) -->
                        </Grid.ColumnDefinitions>

                        <!-- Определяем строки. 'Auto' поджимает высоту под содержимое -->
                        <!-- Используем одинаковую высоту для всех строк с TextBox'ами для выравнивания -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <!-- 0: Pose (выровнено с A) -->
                            <RowDefinition Height="32"/>
                            <!-- 1: Group Mult (выровнено с B) -->
                            <RowDefinition Height="32"/>
                            <!-- 2: Item Mult (выровнено с C) -->
                            <RowDefinition Height="32"/>
                            <!-- 3: Item (выровнено с D) -->
                            <RowDefinition Height="32"/>
                            <!-- 4: Diameter (выровнено с E) -->
                            <RowDefinition Height="32"/>
                            <!-- 5: R Space (выровнено с F) -->
                            <RowDefinition Height="32"/>
                            <!-- 6: Length (выровнено с R) -->
                            <RowDefinition Height="32"/>
                            <!-- 7: Type -->
                            <!-- 8: Material -->
                            <RowDefinition/>
                            <!-- 9: ПУСТОТА (Распорка, толкает Calc вниз) -->
                            <RowDefinition Height="Auto"/>
                            <!-- 10: Кнопка Calculation -->
                        </Grid.RowDefinitions>

                        <!-- Ряд 0: Pose (выровнено с A) -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Pose:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPose" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65"/>

                        <!-- Ряд 1: Group Mult (выровнено с B) -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Group Mult.:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtGroupMult" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65"/>

                        <!-- Ряд 2: Item Mult (выровнено с C) -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Item Mult.:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtItemMult" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65"/>

                        <!-- Ряд 3: Item (выровнено с D, здесь есть кнопка Link) -->
                        <Label Grid.Row="3" Grid.Column="0" Content="Item:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtItem" Grid.Row="3" Grid.Column="1" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="btnLinkItem" Grid.Row="3" Grid.Column="2" Content="Link >" Width="65" Click="btnLinkItem_Click" Height="22" VerticalAlignment="Center"/>

                        <!-- Ряд 4: Diameter (выровнено с E) -->
                        <Label Grid.Row="4" Grid.Column="0" Content="Diameter:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDiameter" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65"/>

                        <!-- Ряд 5: Space (выровнено с F) -->
                        <Label Grid.Row="5" Grid.Column="0" Content="R. Space:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSpace" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65"/>

                        <!-- Ряд 6: Length (выровнено с R, только чтение, серый фон) -->
                        <Label Grid.Row="6" Grid.Column="0" Content="Length:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtLength" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" Background="#F9F9F9" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65"/>

                        <!-- Ряд 7: Type -->
                        <Label Grid.Row="7" Grid.Column="0" Content="Type:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtType" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Text="00" TextChanged="txtType_TextChanged" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65"/>

                        <!-- Ряд 8: Material - УДАЛЕН, перемещен в правую колонку -->

                        <!-- Ряд 10: Кнопка Calculation (В самом низу) -->
                        <!-- ВЫРАВНИВАНИЕ: Поднята по вертикали для совпадения с Determination -->
                            <Button x:Name="btnCalc" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Content="Calculation" Height="35" FontWeight="Bold" Margin="40,0,40,0" VerticalAlignment="Center" Click="btnCalc_Click" Width="100"/>
                            </Grid>
                        </GroupBox>

                        <!-- ============================================= -->
                        <!-- 2. СРЕДНЯЯ КОЛОНКА: Rebar Shape Data -->
                        <!-- ============================================= -->
                        <GroupBox Header="Rebar Shape Data" Grid.Column="1">
                            <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <!-- Буква (A, B) -->
                            <ColumnDefinition/>
                            <!-- Поле ввода -->
                            <ColumnDefinition Width="144"/>
                            <!-- Кнопка Link -->
                        </Grid.ColumnDefinitions>

                        <!-- Строки для размеров - одинаковой высоты для выравнивания с левой колонкой -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <!-- 0: A (выровнено с Pose) -->
                            <RowDefinition Height="32"/>
                            <!-- 1: B (выровнено с Group Mult) -->
                            <RowDefinition Height="32"/>
                            <!-- 2: C (выровнено с Item Mult) -->
                            <RowDefinition Height="32"/>
                            <!-- 3: D (выровнено с Item) -->
                            <RowDefinition Height="32"/>
                            <!-- 4: E (выровнено с Diameter) -->
                            <RowDefinition Height="32"/>
                            <!-- 5: F (выровнено с Space) -->
                            <RowDefinition Height="32"/>
                            <!-- 6: R (выровнено с Length) -->
                            <RowDefinition Height="32"/>
                            <!-- 7: Shape Number (опущен вниз) -->
                            <RowDefinition Height="*"/>
                            <!-- 8: Пустота -->
                            <RowDefinition Height="Auto"/>
                            <!-- 9: Determination -->
                        </Grid.RowDefinitions>

                        <!-- Размеры (A..R) - выровнены с левой колонкой -->
                        <!-- GotFocus используется для сброса желтого цвета (см. C# код) -->

                        <!-- Ряд 0: A (выровнено с Pose) -->
                        <Label Grid.Row="0" Content="A:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="20" Margin="2,0,0,0"/>
                        <TextBox x:Name="txtA" Grid.Row="0" Grid.Column="1" GotFocus="txtDimension_GotFocus" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="btnLinkA" Grid.Row="0" Grid.Column="2" Content="Link >" Click="btnLinkA_Click" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,20,0"/>

                        <!-- Ряд 1: B (выровнено с Group Mult) -->
                        <Label Grid.Row="1" Content="B:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="19" Margin="3,0,0,0"/>
                        <TextBox x:Name="txtB" Grid.Row="1" Grid.Column="1" GotFocus="txtDimension_GotFocus" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="btnLinkB" Grid.Row="1" Grid.Column="2" Content="Link >" Click="btnLinkB_Click" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,20,0"/>

                        <!-- Ряд 2: C (выровнено с Item Mult) -->
                        <Label Grid.Row="2" Content="C:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="20" Margin="2,0,0,0"/>
                        <TextBox x:Name="txtC" Grid.Row="2" Grid.Column="1" GotFocus="txtDimension_GotFocus" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="btnLinkC" Grid.Row="2" Grid.Column="2" Content="Link >" Click="btnLinkC_Click" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,20,0"/>

                        <!-- Ряд 3: D (выровнено с Item) -->
                        <Label Grid.Row="3" Content="D:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="21" Margin="2,0,0,0"/>
                        <TextBox x:Name="txtD" Grid.Row="3" Grid.Column="1" GotFocus="txtDimension_GotFocus" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="btnLinkD" Grid.Row="3" Grid.Column="2" Content="Link >" Click="btnLinkD_Click" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,20,0"/>

                        <!-- Ряд 4: E (выровнено с Diameter) -->
                        <Label Grid.Row="4" Content="E:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="19" Margin="3,0,0,0"/>
                        <TextBox x:Name="txtE" Grid.Row="4" Grid.Column="1" GotFocus="txtDimension_GotFocus" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="btnLinkE" Grid.Row="4" Grid.Column="2" Content="Link >" Click="btnLinkE_Click" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,20,0"/>

                        <!-- Ряд 5: F (выровнено с Space) -->
                        <Label Grid.Row="5" Content="F:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="18" Margin="4,0,0,0"/>
                        <TextBox x:Name="txtF" Grid.Row="5" Grid.Column="1" GotFocus="txtDimension_GotFocus" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="btnLinkF" Grid.Row="5" Grid.Column="2" Content="Link >" Click="btnLinkF_Click" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,20,0"/>

                        <!-- Ряд 6: R (выровнено с Length) -->
                        <Label Grid.Row="6" Content="R:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="20" Margin="2,0,0,0"/>
                        <TextBox x:Name="txtR" Grid.Row="6" Grid.Column="1" GotFocus="txtDimension_GotFocus" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="btnLinkR" Grid.Row="6" Grid.Column="2" Content="Link >" Click="btnLinkR_Click" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,20,0"/>

                        <!-- Ряд 7: Shape Number (опущен вниз, после R) -->
                        <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Shape Number:" Grid.Column="0" HorizontalAlignment="Center" Width="95" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbShapeNumber" Grid.Column="1" SelectionChanged="cmbShapeNumber_SelectionChanged" Width="65" HorizontalAlignment="Right" Height="22" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Кнопка Determination -->
                        <!-- ВЫРАВНИВАНИЕ: Поднята по вертикали для совпадения с Calculation -->
                            <Button x:Name="btnDetermination" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Content="Determination" Height="35" Margin="40,0,40,0" Click="btnDetermination_Click" VerticalAlignment="Center" Width="100"/>
                            </Grid>
                        </GroupBox>

                        <!-- ============================================= -->
                        <!-- 3. ПРАВАЯ КОЛОНКА: Preview и Инфо -->
                        <!-- ============================================= -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <!-- Картинка занимает 3 доли места (увеличено с 2* для большего размера) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Поля внизу занимают сколько нужно -->
                            </Grid.RowDefinitions>

                            <GroupBox Header="Rebar Shape Preview" Grid.Row="0" Padding="15">
                        <!-- 
                    Улучшенное отображение изображения:
                    - Stretch="Uniform" - сохраняет пропорции, вписывается в контейнер (НЕ обрезает края)
                    - RenderOptions.BitmapScalingMode="HighQuality" - высокое качество масштабирования (четкие линии)
                    - RenderOptions.CachingHint="Cache" - кэширование для лучшей производительности
                    - MinWidth и MinHeight - минимальные размеры для гарантии видимости (увеличено для лучшей читаемости)
                    - HorizontalAlignment и VerticalAlignment="Center" - центрирование изображения
                    -->
                        <Image x:Name="imgPreview" 
                           Stretch="Uniform"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           MinHeight="245"
                           MinWidth="245"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.CachingHint="Cache"
                           SnapsToDevicePixels="True" Margin="0,0,0,-15"/>
                            </GroupBox>

                            <!-- Нижняя часть правой колонки (StackPanel просто складывает элементы друг под другом) -->
                            <StackPanel Grid.Row="1" Margin="5">

                        <!-- Поле Pose Image -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Pose Image:" Grid.Column="0"/>
                            <TextBox x:Name="txtPoseImage" Grid.Column="1"/>
                        </Grid>

                        <!-- Поле Note -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Current Note:" Grid.Column="0"/>
                            <TextBox x:Name="txtNote" Grid.Column="1"/>
                        </Grid>

                        <!-- Список Note -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Note List:" Grid.Column="0"/>
                            <ComboBox x:Name="cmbNoteList" Grid.Column="1" Height="22"/>
                        </Grid>

                        <!-- Material (перемещен сюда, на уровень cmbNoteList) -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Material:" Grid.Column="0"/>
                            <ComboBox x:Name="cmbMaterial" Grid.Column="1" Height="22" IsSynchronizedWithCurrentItem="False"/>
                            </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                <!-- ============================================= -->
                <!-- КНОПКИ И TIK НА УРОВНЕ БЛОКОВ -->
                <!-- ============================================= -->
                <!-- Кнопки и Tik расположены в Grid.Row="1" верхней сетки, на уровне блоков Main Data и Rebar Shape Data -->
                <Grid Grid.Row="1" Margin="5,10,5,5">
                    <Grid.ColumnDefinitions>
                        <!-- Зона основных кнопок -->
                        <ColumnDefinition Width="540"/>
                        <!-- Свободное пространство между основными кнопками и правым блоком -->
                        <ColumnDefinition Width="*"/>
                        <!-- Кнопка Settings -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Tik -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Внутренняя сетка на 540px: Update Pose слева, Update All прижат вправо, Discard/Read равномерно между -->
                    <Grid Grid.Column="0" HorizontalAlignment="Left" Width="540">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="53"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="53"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="53"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnUpdatePose" Grid.Column="0" Content="Update Pose" Height="35" FontWeight="Bold" Click="btnUpdate_Click" Width="90" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        <Button x:Name="btnDiscard" Grid.Column="2" Content="Discard" Height="35" Click="btnDiscard_Click" Width="90" HorizontalAlignment="Center" Margin="0"/>
                        <Button x:Name="btnRead" Grid.Column="4" Content="Read" Height="35" Click="btnRead_Click" Width="90" HorizontalAlignment="Center" Margin="0"/>
                        <Button x:Name="btnUpdateAll" Grid.Column="6" Content="Update All" Height="35" Click="btnUpdateAll_Click" Width="90" HorizontalAlignment="Right" Margin="0"/>
                    </Grid>

                    <Button x:Name="btnSettings" Grid.Column="2" Content="Settings" Height="35" Click="btnSettings_Click" Width="90" HorizontalAlignment="Center" Margin="4,0,4,0"/>

                    <!-- Tik (группа 1) справа от Settings -->
                    <Grid Grid.Column="3" Margin="0,0,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Tik:" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtTik" Grid.Column="1" VerticalAlignment="Center" Width="45"/>
                        <RadioButton Content="0:" GroupName="TikGroup" Margin="4,0" VerticalAlignment="Center" Grid.Column="2"/>
                        <RadioButton Content="1:" GroupName="TikGroup" IsChecked="True" Margin="4,0" VerticalAlignment="Center" Grid.Column="3"/>
                    </Grid>
                </Grid>
                </Grid>
            </Grid>
    </Grid>
</Window>