<Window x:Class="PoseEdit2026.PoseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="POSE EDIT 2026 (WPF)" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <!-- РЕСУРСЫ: Здесь мы задаем стили для всех элементов сразу.
         Это позволяет не писать Margin="5" для каждой кнопки. -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <!-- ГЛАВНАЯ СЕТКА: Делит окно на две части (Лево и Право) -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <!-- Левая часть (поля ввода) -->
            <ColumnDefinition Width="2*" />
            <!-- Правая часть (картинка) - она шире -->
        </Grid.ColumnDefinitions>

        <!-- === ЛЕВАЯ КОЛОНКА (Ввод данных) === -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Группа Main Data -->
                <RowDefinition Height="*"/>
                <!-- Группа Размеров (растягивается) -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки внизу -->
            </Grid.RowDefinitions>

            <!-- ГРУППА 1: Основные данные -->
            <GroupBox Header="Main Data" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <!-- Подписи -->
                        <ColumnDefinition Width="*"/>
                        <!-- Поля -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Pose:"/>
                    <TextBox x:Name="txtPose" Grid.Row="0" Grid.Column="1"/>

                    <!-- Сложная строка: Множитель x Кол-во -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Item Mult:"/>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtItemMult" Grid.Column="0"/>
                        <TextBlock Text="x" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtItem" Grid.Column="2"/>
                    </Grid>

                    <Label Grid.Row="2" Grid.Column="0" Content="Diameter:"/>
                    <TextBox x:Name="txtDiameter" Grid.Row="2" Grid.Column="1"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Length:"/>
                    <TextBox x:Name="txtLength" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Background="#F0F0F0"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Type:"/>
                    <TextBox x:Name="txtType" Grid.Row="4" Grid.Column="1" TextChanged="txtType_TextChanged"/>
                </Grid>
            </GroupBox>

            <!-- ГРУППА 2: Размеры (A, B, C...) -->
            <GroupBox Header="Rebar Shape Data" Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- StackPanel просто складывает элементы стопкой -->

                        <!-- Размер A -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="A:" Grid.Column="0"/>
                            <TextBox x:Name="txtA" Grid.Column="1" GotFocus="txtDimension_GotFocus"/>
                            <Button x:Name="btnLinkA" Content="Link" Grid.Column="2" Click="btnLinkA_Click"/>
                        </Grid>

                        <!-- Размер B -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="B:" Grid.Column="0"/>
                            <TextBox x:Name="txtB" Grid.Column="1" GotFocus="txtDimension_GotFocus"/>
                            <Button x:Name="btnLinkB" Content="Link" Grid.Column="2" Click="btnLinkB_Click"/>
                        </Grid>

                        <!-- Размер C -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="C:" Grid.Column="0"/>
                            <TextBox x:Name="txtC" Grid.Column="1" GotFocus="txtDimension_GotFocus"/>
                            <Button x:Name="btnLinkC" Content="Link" Grid.Column="2" Click="btnLinkC_Click"/>
                        </Grid>

                        <!-- Размер D -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="D:" Grid.Column="0"/>
                            <TextBox x:Name="txtD" Grid.Column="1" GotFocus="txtDimension_GotFocus"/>
                            <Button x:Name="btnLinkD" Content="Link" Grid.Column="2" Click="btnLinkD_Click"/>
                        </Grid>

                        <!-- Размер E -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="E:" Grid.Column="0"/>
                            <TextBox x:Name="txtE" Grid.Column="1" GotFocus="txtDimension_GotFocus"/>
                            <Button x:Name="btnLinkE" Content="Link" Grid.Column="2" Click="btnLinkE_Click"/>
                        </Grid>

                        <!-- Размер R -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="R:" Grid.Column="0"/>
                            <TextBox x:Name="txtR" Grid.Column="1" GotFocus="txtDimension_GotFocus"/>
                            <Button x:Name="btnLinkR" Content="Link" Grid.Column="2" Click="btnLinkR_Click"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- ГРУППА 3: Кнопки слева -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Calculation" Width="100" Height="35" FontWeight="Bold" Click="btnCalc_Click"/>
                <Button Content="Determination" Width="100" Height="35" Margin="10,0,0,0" Click="btnDetermination_Click"/>
            </StackPanel>
        </Grid>

        <!-- === ПРАВАЯ КОЛОНКА (Превью) === -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- Картинка занимает все место -->
                <RowDefinition Height="Auto"/>
                <!-- Список внизу -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки -->
            </Grid.RowDefinitions>

            <GroupBox Header="Rebar Shape Preview" Grid.Row="0">
                <!-- Image в WPF автоматически масштабирует картинку идеально -->
                <Image x:Name="imgPreview" Stretch="Uniform" />
            </GroupBox>

            <!-- Выбор номера формы -->
            <Grid Grid.Row="1" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Shape Number:" Grid.Column="0"/>
                <ComboBox x:Name="cmbShapeNumber" Grid.Column="1" Height="30" SelectionChanged="cmbShapeNumber_SelectionChanged"/>
            </Grid>

            <!-- Нижние кнопки -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Update Pose" Grid.Column="0" Height="40" FontWeight="Bold" Click="btnUpdate_Click"/>
                <Button Content="Discard" Grid.Column="1" Height="40" Click="btnDiscard_Click"/>
                <Button Content="Update All" Grid.Column="2" Height="40" Click="btnUpdateAll_Click"/>
                <Button Content="Read" Grid.Column="3" Height="40" Click="btnRead_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>