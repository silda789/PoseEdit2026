(defun c:Unw ( / )
(setvar "cmdecho" 0)
(setq Dialog_id (load_dialog (strcat source_path "Command/Unw.dcl")))
(if (not (new_dialog "Standart_Ayarlar_dialog" Dialog_id)) (exit))
 (action_tile "cizim_birimi"    "(cizim_birimi_act)"   )
 (action_tile "pafta_olcegi"    "(pafta_olcegi_act)"   )
 (action_tile "hazir_yazi"      "(hazir_yazi_act)"     )
 (action_tile "M_T_Y"          "(M_T_Y_act)"         )
 (action_tile "ayarla"          "(ayarla_act)"         )
 (action_tile "ad_cik"          "(ayarlari_dosyaya_yaz2_act) (done_dialog)" )
 (action_tile "cancel"          "(ayarlari_dosyaya_yaz2_act) (done_dialog)" )
(ayarlari_dosyadan_oku)
(ayarlari_dosyadan_oku2)
(ayarlari_ekrana_yaz)
(setq dialog-state (start_dialog))
 (if (= dialog-state 4) (ayarla_action))
(unload_dialog Dialog_id)
(setvar "cmdecho" 1)
(princ)
)
