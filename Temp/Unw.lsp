(defun ayarlari_ekrandan_oku (/)
 (setq tik_m_key   (get_tile "tik_m_key"  ))
 (setq tik_cm_key  (get_tile "tik_cm_key"  ))
 (setq tik_mm_key  (get_tile "tik_mm_key"  ))
  (if (= tik_m_key "1") (setq cizim_birimi "1" ))
  (if (= tik_cm_key "1") (setq cizim_birimi "100" ))
  (if (= tik_mm_key "1") (setq cizim_birimi "1000"  ))
 (setq pafta_olcegi (get_tile "pafta_olcegi" ))
 (setq hazir_yazi   (get_tile "hazir_yazi"   ))
 (setq tik_rus_key  (get_tile "tik_rus_key"  ))
 (setq tik_eng_key  (get_tile "tik_eng_key"  ))
 (setq tik_r_e_key  (get_tile "tik_r_e_key"  ))
  (if (= tik_rus_key "1") (setq cizim_dili "rus" ))
  (if (= tik_eng_key "1") (setq cizim_dili "eng" ))
  (if (= tik_r_e_key "1") (setq cizim_dili "re"  ))
)
;-------------------------------------------------------------------------------
(defun hazir_yazi_liste ( / )
(setq liste nil)
(setq dosya_adi (strcat source_path "Standard/Projeisimleri.txt"))
(setq dosya (open dosya_adi "r"))
(setq yazi_liste_oku  (read-line dosya))
 (while (/= yazi_liste_oku nil)
   (setq liste (cons yazi_liste_oku liste))
   (setq yazi_liste_oku  (read-line dosya))
 )
    (close dosya)
    (setq hazir_liste (reverse liste))
)
;-------------------------------------------------------------------------------
(defun ayarlari_ekrana_yaz (/)
 (hazir_yazi_liste)
(start_list "hazir_yazi")     (mapcar 'add_list hazir_liste) (end_list)
  (if (= cizim_birimi "1000") (setq tik_mm_key "1") (setq tik_mm_key "0"))
  (if (= cizim_birimi "100") (setq tik_cm_key "1") (setq tik_cm_key "0"))
  (if (= cizim_birimi "1")  (setq tik_m_key "1") (setq tik_m_key "0"))
 (set_tile "tik_mm_key" tik_mm_key )
 (set_tile "tik_cm_key" tik_cm_key )
 (set_tile "tik_m_key" tik_m_key )
 (set_tile "pafta_olcegi" pafta_olcegi )
 (set_tile  "hazir_yazi"  hazir_yazi   )
  (if (= cizim_dili "rus") (setq tik_rus_key "1") (setq tik_rus_key "0"))
  (if (= cizim_dili "eng") (setq tik_eng_key "1") (setq tik_eng_key "0"))
  (if (= cizim_dili "re")  (setq tik_r_e_key "1") (setq tik_r_e_key "0"))
 (set_tile "tik_rus_key" tik_rus_key )
 (set_tile "tik_eng_key" tik_eng_key )
 (set_tile "tik_r_e_key" tik_r_e_key )
)
