(defun ayarlari_dosyaya_yaz2 (/)
 (setq dosya (open (strcat client_path "Standard/UNIT.TXT" ) "w"))
 (princ cizim_birimi2 dosya )(princ "\n" dosya)
 (princ pafta_olcegi2 dosya )(princ "\n" dosya)
 (write-line hazir_yazi2 dosya)(princ "\n" dosya)
 (close dosya)
 (setq dosya (open (strcat client_path "Standard/TABLO_DILI.TXT" ) "w"))
 (princ cizim_dili2 dosya ) (princ "\n" dosya)
 (close dosya)
)
;-------------------------------------------------------------------------------
(defun ayarlari_dosyaya_yaz (/)
 (setq dosya (open (strcat client_path "Standard/UNIT.TXT" ) "w"))
 (princ cizim_birimi dosya )(princ "\n" dosya)
 (princ pafta_olcegi dosya )(princ "\n" dosya)
 (princ hazir_yazi dosya )(princ "\n" dosya)
 (setq hazir_yazi1 (nth (atoi (get_tile "hazir_yazi")) hazir_liste))
 (write-line hazir_yazi1 dosya)(princ "\n" dosya)
 (close dosya)
 (setq dosya (open (strcat client_path "Standard/TABLO_DILI.TXT" ) "w"))
 (princ cizim_dili dosya ) (princ "\n" dosya)
 (close dosya)
)
