(defun ayarlari_dosyadan_oku (/)
 (if (= (not (open (strcat client_path "Standard/UNIT.TXT") "r")) t )
 (progn (setq dosya (open (strcat client_path "Standard/UNIT.TXT") "w"))
 (princ "1" dosya )(princ "\n" dosya)
 (princ "1" dosya )(princ "\n" dosya)
 (princ "1" dosya )(princ "\n" dosya)
 (princ "1" dosya )(princ "\n" dosya)
 (close dosya)))
 (setq dosya (open (strcat client_path "Standard/UNIT.TXT") "r"))
  (setq cizim_birimi (read-line dosya) )
  (if (= cizim_birimi nil ) (progn (setq cizim_birimi "1000")) (setq cizim_birimi cizim_birimi ))
  (setq pafta_olcegi (read-line dosya) )
  (if (= pafta_olcegi nil ) (progn (setq pafta_olcegi "100")) (setq pafta_olcegi pafta_olcegi ))
  (setq hazir_yazi   (read-line dosya) )
  (if (= hazir_yazi nil ) (progn (setq hazir_yazi "0")) (setq hazir_yazi hazir_yazi ))
 (close dosya)
 (setq dosya (open (strcat client_path "Standard/TABLO_DILI.TXT" ) "r"))
  (setq cizim_dili (read-line dosya) )
  (if (= cizim_dili nil ) (progn (setq cizim_dili "1")) (setq cizim_dili cizim_dili ))
 (close dosya)
)
