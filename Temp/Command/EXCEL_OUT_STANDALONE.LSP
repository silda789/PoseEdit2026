(defun c:RQTE ( / )
(vl-load-com)
(setq osmode_old (getvar "osmode"))
(setq dimzin_old (getvar "dimzin"))
(setq clayer_old (getvar "clayer"))
(setvar "cmdecho" 0 )
(setvar "osmode"  0 )
(setvar "dimzin"  1 )
(setvar "attreq"  0 )
(setq olcu_carp 0.001 ) ; ölçü mm dir.
(setq eset (ssget (list (cons 0 "INSERT") (cons 2  "RL-POS"))))
(if (= eset nil) (progn (terpri) (princ "\n No element selected...") (exit)))
(setq toplam_bilgi (RENAISSANCE_toplam_bilgi_olustur eset ))
(setq toplam_bilgi (RENAISSANCE_toplam_bilgi_derle toplam_bilgi ))
(setq cap_liste    (cap_bilgi_olustur  toplam_bilgi ))
(ren_metraj_tablo_dosya_yaz cap_liste toplam_bilgi )
(setvar "osmode" osmode_old)
(setvar "clayer" clayer_old)
(setvar "dimzin" dimzin_old)
(setvar "cmdecho" 1)
(princ)
)

