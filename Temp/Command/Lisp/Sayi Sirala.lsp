)
;-------------------------------------------------------------------------------
(defun sayi_arttir (sayi / )
(setq sayi (strcase sayi))
(if (and (> (strlen sayi) 0) (= (atoi sayi) 0))
      (progn
         (if (> (strlen sayi) 1)
             (progn
                (setq sayi_on_bolum (substr sayi 1 (- (strlen sayi) 1)))
                (setq sayi (substr sayi (strlen sayi) 1))
             )
                (setq sayi_on_bolum "")
         )
         (setq sayi (strcat (substr sayi 1 (- (strlen sayi) 1)) (chr (+ 1 (ascii (substr sayi (strlen sayi) 1))))))
      )
         (setq sayi (itoa (+ 1 (atoi sayi))))
)
sayi
)
