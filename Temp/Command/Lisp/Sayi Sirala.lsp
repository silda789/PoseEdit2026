(defun son_yazi (on_ek sayi arka_ek / )
(while (and (/= (atoi sayi) 0) (< (strlen sayi) (atoi ad_yazi_hane_adet))) (setq sayi (strcat "0" sayi)))
(while (and ( = (atoi sayi) 0) (< (strlen sayi) (atoi ad_yazi_hane_adet))) (setq sayi (strcat "A" sayi)))
(if (= ad_sayi_grubu_iptal "1" ) (progn (setq sayi "") (setq arka_ek "")))
(strcat on_ek sayi arka_ek)
)
