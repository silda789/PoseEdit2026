(defun ad_yazi                  ( / )
(ad_layer_liste_olustur)
(ad_ayarlari_dosyadan_oku)
(setq yaz_yuk (atof ad_yeni_yazi_yuk))
(setq yaz_aci (atof ad_yeni_yazi_aci))
(setq ad_basla_sayi (strcase ad_basla_sayi))
(setq sayi ad_basla_sayi)
(if (= ad_yeni_yazi_yaz "1")
(progn
(setq Yerlesim (GetPoint  "\n Yerlesim noktasi..."))
   (while (/= Yerlesim nil)
        (setq clayer_old   (getvar "clayer"  ))
         (if (= ad_layer_degis "1")
           (setvar "clayer" (nth (atoi ad_yeni_layer_adi) ad_layer_liste))
         )
        (setq yeni_yazi (son_yazi ad_yazi_on_ek sayi ad_yazi_arka_ek))
        (command "text" "bc" Yerlesim yaz_yuk yaz_aci yeni_yazi)
        (setvar "clayer"   clayer_old   )
        (setq Yerlesim (GetPoint "\n Yerlesim noktasi..."))
        (setq sayi (sayi_arttir sayi))
      )
))
(if (/= ad_yeni_yazi_yaz "1")
(progn
(if (= ad_layer_mevcut "1") (setq layer_yeni nill))
(if (= ad_layer_degis  "1") (setq layer_yeni (nth (atoi ad_yeni_layer_adi) ad_layer_liste)))
  (setq yazi_eski_ent (ssget ":S" (list (cons -4  "<OR") (cons 0 "TEXT")  (cons 0 "INSERT")  (cons -4  "OR>") )))
  (while (/= yazi_eski_ent nil)
      (if (= (cdr (assoc 0 (entget (ssname yazi_eski_ent 0)))) "TEXT")
           (progn
             (setq yeni_yazi (son_yazi ad_yazi_on_ek sayi ad_yazi_arka_ek))
             (setq yazi_eski_ (entget (ssname yazi_eski_ent 0)))
             (if (= ad_ekle_yazi_degis   "1") (setq yazi_eski_ (SUBST (CONS 1 yeni_yazi)   (ASSOC 1 yazi_eski_) yazi_eski_)))
             (if (= ad_ekle_yazi_on_ek   "1") (setq yazi_eski_ (SUBST (CONS 1 (strcat yeni_yazi "" (cdr (assoc 1 yazi_eski_))))(ASSOC 1 yazi_eski_) yazi_eski_ )))
             (if (= ad_ekle_yazi_arka_ek "1") (setq yazi_eski_ (SUBST (CONS 1 (strcat (cdr (assoc 1 yazi_eski_)) "" yeni_yazi))(ASSOC 1 yazi_eski_) yazi_eski_ )))
             (if (/= layer_yeni nill)         (setq yazi_eski_ (SUBST (CONS 8 layer_yeni)  (ASSOC 8 yazi_eski_) yazi_eski_)))
             (ENTMOD yazi_eski_)
           )
      )
      (if (= (cdr (assoc 0 (entget (ssname yazi_eski_ent 0)))) "INSERT")
           (progn
             (setq ad_attribute_tag (strcase ad_attribute_tag))
             (setq yeni_yazi (son_yazi ad_yazi_on_ek sayi ad_yazi_arka_ek))
             (setq yazi_eski (a_oku (ssname yazi_eski_ent 0) ad_attribute_tag))
             (if (= ad_ekle_yazi_degis   "1")  (att_yaz (ssname yazi_eski_ent 0) ad_attribute_tag         yeni_yazi            ))
             (if (= ad_ekle_yazi_on_ek   "1")  (att_yaz (ssname yazi_eski_ent 0) ad_attribute_tag (strcat yeni_yazi yazi_eski )))
             (if (= ad_ekle_yazi_arka_ek "1")  (att_yaz (ssname yazi_eski_ent 0) ad_attribute_tag (strcat yazi_eski yeni_yazi )))
           )
      )
     (setq sayi (sayi_arttir sayi))
     (setq yazi_eski_ent (ssget ":S" (list (cons -4  "<OR") (cons 0 "TEXT")  (cons 0 "INSERT")  (cons -4  "OR>") )))
  )
))
(ad_ayarlari_dosyadan_oku)
(setq ad_basla_sayi sayi)
(ad_ayarlari_dosyaya_yaz2)
(princ)
)
