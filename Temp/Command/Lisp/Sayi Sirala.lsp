(defun c:sd ( / )
(setvar "cmdecho" 0)
        (setq id (load_dialog (strcat source_pathlisp"Lisp/Sayi Sirala.dcl")))
        (if (not (new_dialog "ad_dialog" id))(exit))
           (action_tile "ad_basla_sayi"        "(ad_basla_sayi_act)"        )
           (action_tile "ad_basla_sayi_0"      "(ad_basla_sayi_0_act)"      )
           (action_tile "ad_yazi_on_ek"        "(ad_yazi_on_ek_act)"        )
           (action_tile "ad_yazi_on_ek_al"     "(ad_yazi_on_ek_al_act)"     )
           (action_tile "ad_yazi_arka_ek"      "(ad_yazi_arka_ek_act)"      )
           (action_tile "ad_yazi_arka_ek_al"   "(ad_yazi_arka_ek_al_act)"   )
           (action_tile "ad_yazi_hane_adet"    "(ad_yazi_hane_adet_act)"    )
           (action_tile "ad_yeni_yazi_yaz"     "(ad_yeni_yazi_yaz_act)"     )
           (action_tile "ad_yeni_yazi_yuk"     "(ad_yeni_yazi_yuk_act)"     )
           (action_tile "ad_yeni_yazi_aci"     "(ad_yeni_yazi_aci_act)"     )
           (action_tile "ad_ekle_yazi_degis"   "(ad_ekle_yazi_degis_act)"   )
           (action_tile "ad_ekle_yazi_on_ek"   "(ad_ekle_yazi_on_ek_act)"   )
           (action_tile "ad_ekle_yazi_arka_ek" "(ad_ekle_yazi_arka_ek_act)" )
           (action_tile "ad_layer_mevcut"      "(ad_layer_mevcut_act)"      )
           (action_tile "ad_layer_degis"       "(ad_layer_degis_act)"       )
           (action_tile "ad_yeni_layer_adi"    "(ad_yeni_layer_adi_act)"    )
           (action_tile "ad_sayi_grubu_iptal"  "(ad_sayi_grubu_iptal_act)"  )
           (action_tile "ad_hazir_yazi"        "(ad_hazir_yazi_act)"        )
           (action_tile "ad_attribute_tag"     "(ad_attribute_tag_act)"     )
           (action_tile "ad_ciz"               "(ad_ciz_act)"               )
           (action_tile "ad_cik"               "(done_dialog)  (exit)"      )
           (action_tile "cancel"               "(done_dialog)  (exit)"      )
      (ad_yazi_basla)
    (setq dialog-state (start_dialog))
 (if (= dialog-state 4) (ad_yazi))
 (if (= dialog-state 5) (progn (ad_yazi_on_ek_al_action)   (c:sd)))
 (if (= dialog-state 6) (progn (ad_yazi_arka_ek_al_action) (c:sd)))
(setvar "cmdecho" 1)
)
