(defun ad_hazir_yazi_liste ( / )
(setq ad_liste nil)
(setq dosya_adi (strcat source_pathlisp"Ayar/HAZIR_YAZI.txt"))
(setq dosya (open dosya_adi "r"))
(setq ad_yazi_liste_oku  (read-line dosya))
 (while (/= ad_yazi_liste_oku nil)
   (setq ad_liste (cons ad_yazi_liste_oku ad_liste))
   (setq ad_yazi_liste_oku  (read-line dosya))
 )
    (close dosya)
    (setq ad_hazir_liste (reverse ad_liste))
)
