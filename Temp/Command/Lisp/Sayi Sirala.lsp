(defun ad_layer_liste_olustur ( / layer_adi)
(setq ad_layer_liste nil)
(setq ad_layer_bilgi (tblnext "layer" T))
  (while (/= ad_layer_bilgi nil)
    (setq layer_adi  (cdr (assoc  2 ad_layer_bilgi )))
    (setq ad_layer_liste (cons layer_adi ad_layer_liste))
    (setq ad_layer_bilgi (tblnext "layer" ))
  )
    (setq ad_layer_liste (acad_strlsort  ad_layer_liste))
)
