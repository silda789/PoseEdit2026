(defun c:tet (  /  )
       (vl-load-com)
       (terpri)
       (setq ciz (ssget '((0 . "line"))))
       (setq L 0)
       (setq N (SSLENGTH ciz))
       (while (< l n)
       (setq eleman (ENTGET (SSNAME ciz L)))

       (setq nk1 (cdr (assoc 10 eleman)))
       (setq nk2 (cdr (assoc 11 eleman)))
       (setq aci (angle nk1 nk2))
       (setq y1 (polar nk1 (+ aci (* -0.5 pi)) (GETVAR "DIMDLE")))
       (setq y2 (polar nk2 (+ aci (* -0.5 pi)) (GETVAR "DIMDLE")))
       (entdel (SSNAME ciz L) )
       (setq obj (vla-AddDimRotated model_space (vlax-3D-point y1) (vlax-3D-point y2)
                 (vlax-3D-point (polar y2 (+ aci (* pi 0.5)) (GETVAR "DIMDLE"))) aci))
	(vla-put-Layer obj "ren.arrow")
    (princ)
    (setq l (+ l  1)))
)

