(defun c:ett (  /  )
       (SETQ OL (* 0.01 (OLCEK_OKU)))
       (setq clayer_old   (getvar "clayer"  ))
       (setq osmode_old   (getvar "osmode"  ))
       (setvar "osmode"   0)
       (command "clayer" "ren.arrow")
       (setq dnt1 (entget (car (entsel "\n 1.Donatiyi secin..."))))
       (setq dnt2 (entget (car (entsel "\n 2.Donatiyi secin..."))))
       (if (= donatiarasimesafe nil) (progn (initget 1)(setq donatiarasimesafe (getreal "\nMesafeyi Girin :")))
                      (progn
                            (princ (strcat "\nMesafeyi Girin <" (rtos donatiarasimesafe 2 1)"> : "))
                            (setq donatiarasimesafe1  (getreal ))
                            (if (or (= donatiarasimesafe1 nil)(= donatiarasimesafe1 ""))
                                (setq donatiarasimesafe donatiarasimesafe)
                                (setq donatiarasimesafe donatiarasimesafe1)
                            )
                      )
       )
       (setq mes donatiarasimesafe)
       (command "_.undo" "group")
       (setq tanim (cdr (assoc 0 dnt1)))
             (if (= tanim "LWPOLYLINE")
                 (progn
                       (setq yc1 (cdr (assoc 40 dnt1)))
                       (setq yc2 (cdr (assoc 40 dnt2)))
                       (setq nk1 (donut_center dnt1))
                       (setq nk4 (donut_center dnt2))
                )
                 (progn
                       (setq nk1 (cdr (assoc 10 dnt1)))
                       (setq nk4 (cdr (assoc 10 dnt2)))
                 )
             )
             (setq obje (ssget "_F" (list nk1 nk4) (list '(-4 . "<OR") '(-4 . "<AND")
              '(0 . "LWPOLYLINE") '(90 . 2) '(70 . 1) '(-4 . "AND>")
              '(0 . "CircLe") '(-4 . "OR>"))))
       (setq L 0)
       (setq aci   (angle nk1 nk4))
       (setq nk2 (polar nk1 (+ aci (* pi 0.5)) mes))
       (setq nk3 (polar nk4 (+ aci (* pi 0.5)) mes))
       (command "line" nk2 nk3 "")
       (setq N (SSLENGTH obje))
       (while (< l n)
              (if (= tanim "LWPOLYLINE")
                  (progn
                        (setq eleman (ENTGET (SSNAME obje L)))
                        (setq yc3 (cdr (assoc 40 eleman)))
                        (setq nk5 (donut_center eleman))
                  )
                  (progn
                        (setq eleman (ENTGET (SSNAME obje L)))
                        (setq nk5 (cdr (assoc 10 eleman)))
                  )
              )
              (setq nk6 (polar nk5 (+ aci (/ pi 2 )) mes))
              (command "line" nk5 nk6 "")
              (setq l (+ l  1))
       (princ)
       )
       (command "_.undo" "e")
       (setvar "clayer"   clayer_old   )
       (setvar "osmode"   osmode_old   )
       (princ)
)
