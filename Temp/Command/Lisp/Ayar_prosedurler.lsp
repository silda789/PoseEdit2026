(defun liste_yap (dosya / dosya okunan dosya_oku)
(setq dosya_oku (open dosya  "r"))
(setq liste nil)
    (setq okunan (read-line dosya_oku))
               (while (/= okunan nil)
                  (setq liste  (cons okunan liste  ))
                  (setq okunan (read-line dosya_oku))
               )
    (setq liste (reverse liste))
 (close dosya_oku)
)
