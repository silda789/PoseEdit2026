(defun  kod_degis  (
                     entiti_list
                     new_feature
                     list_no
                                    /  entiti_list new_feature list_no old_feature
                    )
(setq old_feature (cdr (assoc list_no entiti_list)))
(setq entiti_list (subst (cons list_no new_feature) (assoc list_no entiti_list) entiti_list))
(entmod entiti_list)
(princ)
)
