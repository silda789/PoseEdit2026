(defun deger_degistir ( dosya sira deger / dosya sira deger okunan isim i liste)
(setq isim  (strcat source_pathlisp"Ayar/" dosya)  )
(setq takas (strcat source_pathlisp"Ayar/temp.txt"))

    (setq dosya_oku (open isim  "r"))
     (setq dosya_yaz (open takas "w"))
         (setq okunan (read-line dosya_oku))
               (while (/= okunan nil)
                  (princ okunan dosya_yaz) (princ "\n" dosya_yaz)
                  (setq  okunan (read-line dosya_oku))
               )
     (close dosya_yaz)
    (close dosya_oku)
(setq i 1)
    (setq dosya_yaz (open takas "r"))
     (setq dosya_oku (open isim  "w"))
         (setq okunan (read-line dosya_yaz))
               (while (/= okunan nil)
                  (if (= sira i)
                         (progn (princ deger  dosya_oku) (princ "\n" dosya_oku))
                         (progn (princ okunan dosya_oku) (princ "\n" dosya_oku))
                   )
                  (setq i (+ i 1))
                  (setq  okunan (read-line dosya_yaz))
               )
     (close dosya_oku)
    (close dosya_yaz)
(princ)
)
