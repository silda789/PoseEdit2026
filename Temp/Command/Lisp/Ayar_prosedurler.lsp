(defun donut_center (donut / )
(setq k 0 ptlist nil)
  (repeat (length donut)
    (setq bb_en (nth k donut))
    (if (= (car bb_en) 10) (setq ptlist (append ptlist (list (cdr bb_en)))))
    (setq k (1+ k))
  )
(setq pn (polar (car ptlist) (angle (car ptlist) (cadr ptlist)) (/ (distance (car ptlist) (cadr ptlist)) 2.0)))
pn
)
