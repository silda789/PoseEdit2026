(defun tan (aci / aci) (/ (sin aci) (cos aci)) )
;-----------------------------------------------------------------------
(defun yaz ( yazi / yazi )(princ "\n")(princ yazi)(princ "\n"))
;-----------------------------------------------------------------------
(defun rtod (a)   (/ (* a 180.0) pi) )
;-----------------------------------------------------------------------
(defun dtor (a)   (* (/ a 180  ) pi) )
;-----------------------------------------------------------------------
(defun midpoint (P1 P2) (polar  P1 (angle P1 P2) (/ (distance P1 P2) 2.0)) )
;-----------------------------------------------------------------------
(defun StrPos (s1 s2 / l1 l2 i n )
   (setq i 1 l1 (strlen s1) l2 (strlen s2) n 0)
   (while (<= i l2)
          (if (= (substr s2 i l1) s1)
              (setq n i i l2)
          )
          (setq i (1+ i))
   )
   (setq i n)
)
;-----------------------------------------------------------------------
(defun rtoa (a i j / s)
   (setq s (rtos a i j))
   (if (/= (StrPos "." s) 0)
       (progn
          (while (and (> j 0) (= (substr s (strlen s) 1) "0"))
                 (setq j (1- j) s (substr s 1 (1- (strlen s))))
          )
          (if (= (substr s (strlen s) 1) ".")
              (setq s (substr s 1 (1- (strlen s))))
          )
       )
   )
   (setq s s)
)
