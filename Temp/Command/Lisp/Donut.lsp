(defun c:don4 ( / )
(setq osmode_old   (getvar "osmode"  ))
(setq clayer_old   (getvar "clayer"  ))
(setvar "osmode"   0)
(layer_yap "ren.reinforcement"  "7" "continuous")
(command "clayer" "ren.reinforcement")
(setq dnt1 (ssget '((0 . "LWPOLYLINE"))))
(command "_.undo" "group")
(if (= dnt1 nil)
      (progn
        (setq dnt1 (ssget))))
(setq L 0)
(setq N (SSLENGTH dnt1))
(while (< l n)
(setq eleman (ENTGET (SSNAME dnt1 L)))
(setq r1 (cdr (assoc 40 eleman)))
(setq n1 (donut_center eleman))
(setq r2 (/ 2 r1))
(entmake (list (cons 0 "CIRCLE")
                  (cons 10 n1)
                  (cons 40 r1)
                  (cons 8 "ren.reinforcement")
                  ))
(entdel (SSNAME dnt1 L) )
(princ)(setq l (+ l  1)))
(setvar "osmode"   osmode_old   )
(setvar "clayer"   clayer_old   )
(princ)
(command "_.undo" "e")
)
