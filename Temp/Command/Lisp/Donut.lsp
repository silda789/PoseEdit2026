(defun c:dd (/)
	(setvar "cmdecho" 0)
    (SETQ OL (* 0.01 (OLCEK_OKU)))
	(while (= 0)
           (setq nok1 (getpoint "\n Donatý yeleþtirilecek nokta."))
	       (setq nk1 (polar nok1 pi (* ol 37.125)))
	       (setq p3 (list (car nk1) (cadr nk1)))
	       (setq nk2 (polar nok1 0 (* ol 37.125)))
	       (setq p4 (list (car nk2) (cadr nk2)))
	       (entmake (list
					     (cons 0 "LWPOLYLINE")
