					     (cons 410 "Model")
					     (cons 8 "ren.arrow")
					     (cons 100 "AcDbPolyline")
					     (cons 90 2)
					     (cons 70 1)
					     (cons 43 (* ol 74.2500))
					     (cons 10 p3)
					     (cons 40 0)
					     (cons 41 0)
					     (cons 42 1.0)
					     (cons 10 p4)
					     (cons 40 0)
					     (cons 41 0)
					     (cons 42 1.0)
