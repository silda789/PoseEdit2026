(defun alan_yazi (pt1 text height)
  (entmake (list (cons 0 "TEXT")
		 (cons 100 "AcDbEntity")
		 (cons 100 "AcDbText")
		 (cons   7 "R")
		 (cons  10  pt1)
		 (cons  11  pt1)
		 (cons   1  text)
		 (cons  40  height)
		 (cons  50  0)
		 (cons  41  0.75)
		 (cons  72  1)
		 (cons  73  2)
		 (cons   8 "0")
           )
  )
(princ)
)
; -----------------------------------------------------------------------------------------
; --- ALAN VE CEVRE HESAPLAR --------------------------------------------------------------
; -----------------------------------------------------------------------------------------
(defun alan_hesap ( p  / )
(setvar "cmdecho"  0)
(setq toplam_alan 0.0)
(setq l 0 n (sslength p))
    (if (/= p nil)
      (progn
        (while (< l n)
            (command "area" "o" (ssname p l))
            (setq alan  (getvar "area"     ))
            (setq toplam_alan  (+ toplam_alan   alan))
            (setq l (+ l 1))
        )
      )
    )
toplam_alan
)
; -----------------------------------------------------------------------------------------
(defun cevre_hesap ( p / )
(setvar "cmdecho"  0)
(setq toplam_cevre 0.0)
(setq l 0 n (sslength p))
    (if (/= p nil)
      (progn
        (while (< l n)
            (command "area" "o" (ssname p l))
            (setq cevre (getvar "perimeter"))
            (setq toplam_cevre (+ toplam_cevre cevre))
            (setq l (+ l 1))
        )
      )
    )
toplam_cevre
)
; -----------------------------------------------------------------------------------------
(defun c:a ( / toplam_alan toplam_cevre p l n alan cevre yazi_1 yazi_2)
(setq dimzin_old (getvar "dimzin"))
(setvar "dimzin" 1)
(setq osmode_old (getvar "osmode"  ))
(SETQ k1 (GETVAR "DIMSCALE"))
(SETQ k2 (GETVAR "DIMLFAC"))
(setq yaz_yuk   (* 25 k2) )
(setq olc_carp (BIRIM_OKU))
(setq p (ssget))
(setq toplam_alan  (alan_hesap  p))
(setq toplam_cevre (cevre_hesap p))
(alert (setq sp1 (strcat "Alan: " (rtos (/ (* toplam_alan  (* k2 k2 )) (* olc_carp olc_carp) ) 2 2) " m2   Cevre: " (rtos (/ (* toplam_cevre k2 )  olc_carp) 2 2) " mt") ;_strcat
		 ) ;_setq
	  ) ;_alert
	  (princ sp1)
(setvar "osmode" osmode_old)
(setvar "dimzin" dimzin_old)
)
