(defun c:ay ( / toplam_alan toplam_cevre p l n alan cevre yazi_1 yazi_2)
(setq dimzin_old (getvar "dimzin"))
(setvar "dimzin" 1)
(setq osmode_old (getvar "osmode"  ))
(SETQ k1 (GETVAR "DIMSCALE"))
(SETQ k2 (GETVAR "DIMLFAC"))
(setq olc_carp (BIRIM_OKU))
(setq yaz_yuk   (* 2.5  k2) )
(princ "\n Genel alan......:")
(setq p_set1 (ssget))
(setq alan1  (alan_hesap  p_set1))
(setq cevre1 (cevre_hesap p_set1))
(princ "\n Çýkarýlacak alan......:")
(setq p_set2 (ssget))
(setq alan2  (alan_hesap  p_set2))
(setq cevre2 (cevre_hesap p_set2))
(setq yazi_1   (strcat "A: "  (rtos (/ (- alan1   alan2 ) (* 10 olc_carp) ) 2 2)  " m² " ))
(setq yazi_2   (strcat "C: "  (rtos (/ (+ cevre1 cevre2 )    olc_carp           ) 2 2)  " mt " ))
(setq pt1 (getpoint "\nYerlesim noktasý..."))
(setvar "osmode"   0)
(if (/= pt1 nil) (progn (alan_yazi pt1 yazi_1 yaz_yuk)
                        (setq pt1 (polar pt1 (* pi 1.5) (* 1.5 yaz_yuk)))
                        (alan_yazi pt1 yazi_2 yaz_yuk)))
(setvar "osmode" osmode_old)
(setvar "dimzin" dimzin_old)
(princ)
)
