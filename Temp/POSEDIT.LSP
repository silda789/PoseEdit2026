(defun poz_edit_adet_carpi (tb / )
(fi_)
(setq position      0)
(setq position_last 0)
(setq fi_yeri (vl-string-search fi tb))
(setq fi_boyu (strlen fi))
(setq adet_kismi (substr tb 1 fi_yeri))
(if (and (> (strlen adet_kismi) 0 )
         (/= (vl-string-search "X" (strcase adet_kismi)) nil ))
       (progn
         (while (/= position nil)
          (if (/= position nil)
                (progn
                    (setq position_last (max position position_last))
                    (setq position (vl-string-search "X" (strcase adet_kismi) (1+ position)))
                 )
          )
         )
         (setq adet_carp (substr adet_kismi 1 position_last ))
       )
      (setq adet_carp "")
)
adet_carp
)
