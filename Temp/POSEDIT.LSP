(defun adet_icin_boy_oku (en2 / )
(setq adet_al_boy 0)
  (if (= (CDR (ASSOC 0 (entget en2))) "TEXT"       )  (setq adet_al_boy (ATOF (cdr (assoc 1 (entget en2))))))
  (if (= (CDR (ASSOC 0 (entget en2))) "LINE"       )  (setq adet_al_boy (* yaz_olc (distance (cdr (assoc 10 (entget en2))) (cdr (assoc 11 (entget en2)))))))
  (if (= (CDR (ASSOC 0 (entget en2))) "LWPOLYLINE" )  (setq adet_al_boy (* yaz_olc (vlax-curve-getDistatParam en2 (vlax-curve-getEndParam en2)))))
  (if (= (CDR (ASSOC 0 (entget en2))) "ARC"        )  (setq adet_al_boy (* yaz_olc (vlax-curve-getDistatParam en2 (vlax-curve-getEndParam en2)))))
  (if
    (or
      (= (CDR (ASSOC 0 (entget en2))) "DIMENSION"             )
      (= (CDR (ASSOC 0 (entget en2))) "ARC_DIMENSION"         )
      (= (CDR (ASSOC 0 (entget en2))) "LARGE_RADIAL_DIMENSION")
    )
      (setq adet_al_boy (cdr (assoc 42 (entget en2))))
  )
adet_al_boy
)
