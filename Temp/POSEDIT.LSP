(defun pline_icin_arc_coz ( P01 P02 ARC_H / P01 P02 ARC_G )
(setq s_value (distance P01 P02))
(setq h_value (* (* 0.5 s_value) ARC_H))
(setq r_value (+ (* 0.5 h_value)  (/ (* s_value s_value) (* 8 h_value))))
(setq a_value (* 4 (atan ARC_H)))
(setq b_value (* r_value a_value))
;(setq BB_A  (rtos (float (* (fix (+ (/ (* OLCEK b_value) SAYI) 0.5)) SAYI)) 2 0))
;(setq BB_B  (rtos (float (* (fix (+ (/ (* OLCEK s_value) SAYI) 0.5)) SAYI)) 2 0))
;(setq BB_C  (rtos (float (* (fix (+ (/ (* OLCEK h_value) SAYI) 0.5)) SAYI)) 2 0))
;(setq BB_R  (rtos (float (* (fix (+ (/ (* OLCEK r_value) SAYI) 0.5)) SAYI)) 2 0))
(princ)
)
