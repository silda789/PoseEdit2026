(defun visibility_RL-POS2 ( en / )
   (setvar "cmdecho" 0 )
   (setvar "dimzin"  1 )
    (setq tb_visibility  (att_prop_oku en "TB"  "Invisible"))
    (setq not_visibility (att_prop_oku en "NOT" "Invisible"))
       (if (and (= tb_visibility :vlax-true ) (= not_visibility :vlax-true )) (att_prop_yaz en "TB"  "Invisible" "false" ) )
       (if (and (= tb_visibility :vlax-false) (= not_visibility :vlax-true )) (att_prop_yaz en "NOT" "Invisible" "false" ) )
       (if (and (= tb_visibility :vlax-false) (= not_visibility :vlax-false)) (att_prop_yaz en "TB"  "Invisible" "true"  ) )
       (if (and (= tb_visibility :vlax-true ) (= not_visibility :vlax-false)) (att_prop_yaz en "NOT" "Invisible" "true"  ) )
       (pozbilgi_sekil_topla en)
   (VL-CmdF "_.UpdateField" en "")
   (setvar "clayer" clayer_old)
   (setvar "dimzin" dimzin_old)
   (setvar "cmdecho" 1)
   (gc)
   (gc)
   (gc)
   (princ)
   (exit)
)
