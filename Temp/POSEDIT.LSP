(defun arc_coz ( e / e P01 P02 ARC_G )
(setq r_value (cdr (assoc 40  (entget e))))
(setq cevre1  (cdr (assoc 50  (entget e))))
(if (= cevre1 nil) (setq cevre1 0))
(setq cevre2  (cdr (assoc 51  (entget e))))
(if (< cevre2 cevre1) (setq cevre2 (+ cevre2 6.283185307)))
(setq cevre3  (- cevre2 cevre1))
(setq b_value (* cevre3 (cdr (assoc 40  (entget e)))))
(setq P01 (polar (cdr (assoc 10  (entget e))) (cdr (assoc 50  (entget e))) (cdr (assoc 40  (entget e)))))
(setq P02 (polar (cdr (assoc 10  (entget e))) (cdr (assoc 51  (entget e))) (cdr (assoc 40  (entget e)))))
(setq s_value (distance P01 P02))
(setq P03 (polar P01 (angle P01 P02) (/ (distance P01 P02) 2.0)))
(setq h_value (- r_value (distance P03 (cdr (assoc 10  (entget e))))))
;(setq BB_A  (rtos (float (* (fix (+ (/ (* OLCEK b_value) SAYI) 0.5)) SAYI)) 2 0))
;(setq BB_B  (rtos (float (* (fix (+ (/ (* OLCEK s_value) SAYI) 0.5)) SAYI)) 2 0))
;(setq BB_C  (rtos (float (* (fix (+ (/ (* OLCEK h_value) SAYI) 0.5)) SAYI)) 2 0))
;(setq BB_R  (rtos (float (* (fix (+ (/ (* OLCEK r_value) SAYI) 0.5)) SAYI)) 2 0))
(princ)
)
