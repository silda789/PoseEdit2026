(if (> (strlen adet_kismi) 0 )
      (if (= (vl-string-search "X" (strcase adet_kismi)) nil)
       (setq adet adet_kismi)
       (progn
         (while (/= position nil)
          (if (/= position nil)
                (progn
                    (setq position_last (max position position_last))
                    (setq position (vl-string-search "X" (strcase adet_kismi) (1+ position)))
                 )
          )
         )
          (setq adet (substr adet_kismi (+ position_last 2)))
       )
      )
      (setq adet "")
)
adet
