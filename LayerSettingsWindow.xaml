<!-- 
    ОКНО: LayerSettingsWindow.xaml
    НАЗНАЧЕНИЕ: Окно для настройки создания стандартных слоев в AutoCAD
    ====================================================================================
    Это окно позволяет пользователю:
    1. Указать префикс для стандартных слоев (например: "std", "ren", "model")
    2. Выбрать, какие стандартные слои создавать
    3. Все параметры слоев (цвет, тип линии, вес) уже заданы в стандарте
-->
<Window x:Class="PoseEdit2026.LayerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Create Standard Layers" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F0F0F0"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#DDDDDD"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: Префикс и опции -->
        <GroupBox Header="Layer Prefix and Options" Grid.Row="0" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Label Content="Prefix:" Grid.Column="0" Margin="0,0,5,0"/>
                <TextBox x:Name="txtPrefix" Grid.Column="1" Text="" TextChanged="txtPrefix_TextChanged"/>
                
                <Button Content="Select All" Grid.Column="2" Width="100" Margin="10,0,5,0" Click="btnSelectAll_Click"/>
                <Button Content="Deselect All" Grid.Column="3" Width="100" Click="btnDeselectAll_Click"/>
            </Grid>
        </GroupBox>

        <!-- Основная область: Список стандартных слоев -->
        <GroupBox Header="Standard Layers (from LAYERS-Model.pdf)" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Информация о количестве выбранных слоев -->
                <TextBlock x:Name="txtSelectedCount" 
                           Text="0 layers selected" 
                           Grid.Row="0"
                           Margin="0,0,0,5"
                           FontWeight="Bold"
                           Foreground="Blue"/>
                
                <!-- Заголовки столбцов -->
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="1" 
                               Text="Layer Name" 
                               FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" 
                               Text="Color" 
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Grid.Column="3" 
                               Text="Linetype" 
                               FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" 
                               Text="Weight" 
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Grid.Column="5" 
                               Text="Description" 
                               FontWeight="Bold"
                               Margin="5,0,0,0"/>
                </Grid>
                
                <!-- Список слоев с чекбоксами -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="itemsControlLayers">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsSelected}" 
                                              Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Name}" 
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding ColorIndex}" 
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Grid.Column="3" 
                                               Text="{Binding Linetype}" 
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" 
                                               Text="{Binding LineWeightDisplay}" 
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Grid.Column="5" 
                                               Text="{Binding Description}" 
                                               FontSize="10"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="5,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </GroupBox>

        <!-- Нижняя панель с кнопками -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Опция пропуска существующих слоев -->
            <CheckBox x:Name="chkSkipExisting" 
                      Content="Skip existing layers" 
                      IsChecked="True" 
                      Grid.Column="0"
                      VerticalAlignment="Center"/>
            
            <Button x:Name="btnCancel" 
                    Grid.Column="1" 
                    Content="Cancel" 
                    Width="120" 
                    Height="35" 
                    Margin="0,0,10,0" 
                    Click="btnCancel_Click"/>
            
            <Button x:Name="btnOK" 
                    Grid.Column="2" 
                    Content="Create Layers" 
                    Width="140" 
                    Height="35" 
                    FontWeight="Bold" 
                    Click="btnOK_Click"/>
        </Grid>
    </Grid>
</Window>

