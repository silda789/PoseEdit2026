<!-- 
    ОКНО: SettingsWindow.xaml
    НАЗНАЧЕНИЕ: Отдельное окно для настроек приложения
    ====================================================================================
    Это окно заменяет вкладку Settings из главного окна PoseEditWindow.
    Содержит все настройки: масштаб, единицы измерения, язык таблиц, имя проекта, размещение таблиц.
-->
<Window x:Class="PoseEdit2026.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings - PoseEdit 2026" 
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F0F0F0"
        WindowStyle="SingleBorderWindow">

    <!-- Стили для элементов окна (аналогично главному окну) -->
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#DDDDDD"/>
        </Style>
    </Window.Resources>

    <!-- Главная сетка -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Основная область с настройками -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Настройки -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ГРУППА: Масштаб чертежа -->
                <GroupBox Header="Sheet Scale" Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Scale 1 /" Grid.Column="0"/>
                        <TextBox x:Name="txtSheetScale" Grid.Column="1" Text="50"/>
                    </Grid>
                </GroupBox>

                <!-- ГРУППА: Единицы измерения -->
                <GroupBox Header="Drawing Unit" Grid.Row="1">
                    <StackPanel>
                        <RadioButton x:Name="rbMeter" Content="Meter" GroupName="Units" IsChecked="False" Checked="rbUnit_Checked"/>
                        <RadioButton x:Name="rbCentimeter" Content="Centimeter" GroupName="Units" IsChecked="False" Checked="rbUnit_Checked"/>
                        <RadioButton x:Name="rbMillimeter" Content="Millimeter" GroupName="Units" IsChecked="True" Checked="rbUnit_Checked"/>
                    </StackPanel>
                </GroupBox>

                <!-- ГРУППА: Язык таблиц -->
                <GroupBox Header="Quantity Table Language" Grid.Row="2">
                    <StackPanel>
                        <RadioButton x:Name="rbRus" Content="Russian" GroupName="Language" IsChecked="True" Checked="rbLanguage_Checked"/>
                        <RadioButton x:Name="rbEng" Content="English" GroupName="Language" IsChecked="False" Checked="rbLanguage_Checked"/>
                        <RadioButton x:Name="rbRusEng" Content="Russian/English" GroupName="Language" IsChecked="False" Checked="rbLanguage_Checked"/>
                    </StackPanel>
                </GroupBox>

                <!-- ГРУППА: Имя проекта -->
                <GroupBox Header="Project Name" Grid.Row="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="cmbProjectName" Grid.Row="0" Height="30" IsEditable="True" SelectionChanged="cmbProjectName_SelectionChanged"/>
                        <Button Content="Add to List" Grid.Row="1" Height="25" Margin="0,5,0,0" Click="btnAddProject_Click" FontSize="10"/>
                    </Grid>
                </GroupBox>

                <!-- ГРУППА: Размещение таблиц -->
                <GroupBox Header="Table Placement" Grid.Row="4">
                    <StackPanel>
                        <RadioButton x:Name="rbPlacement1" Content="Placement-1" GroupName="Placement" IsChecked="False" Checked="rbPlacement_Checked" Margin="0,2"/>
                        <RadioButton x:Name="rbPlacement2" Content="Placement-2" GroupName="Placement" IsChecked="False" Checked="rbPlacement_Checked" Margin="0,2"/>
                        <RadioButton x:Name="rbPlacement3" Content="Placement-3" GroupName="Placement" IsChecked="True" Checked="rbPlacement_Checked" Margin="0,2"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- Правая колонка (зарезервировано для будущих функций) -->
            <Grid Grid.Column="1" Background="#F5F5F5">
                <TextBlock Text="Reserved for future features" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Foreground="Gray" 
                           FontStyle="Italic"/>
            </Grid>
        </Grid>

        <!-- Нижняя панель с кнопками -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Пустое место слева -->
            <StackPanel Grid.Column="0"/>

            <!-- Кнопка Cancel -->
            <Button x:Name="btnCancel" Grid.Column="1" Content="Cancel" Width="120" Height="35" Margin="0,0,10,0" Click="btnCancel_Click"/>

            <!-- Кнопка Save Settings -->
            <Button x:Name="btnSaveSettings" Grid.Column="2" Content="Save Settings" Width="120" Height="35" FontWeight="Bold" Click="btnSaveSettings_Click"/>
        </Grid>
    </Grid>
</Window>

